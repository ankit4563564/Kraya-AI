# ==============================================================================
# KRAYA — ₹0/Month Free Live Production Configuration
# Leave optional external keys blank to run locally with PGlite + local vault + deterministic parsers.
# NEVER commit a populated .env file to version control.
# ==============================================================================

# Server & Security
PORT=8787
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Auth is ON by default (recommended). Set REQUIRE_AUTH=false ONLY for local non-auth scripts (blocked in production).
REQUIRE_AUTH=true
# Generate a strong 32-byte hex secret (`openssl rand -hex 32`) for signed file download URLs & cookies:
SESSION_SECRET=change-me-to-32-byte-random-hex-in-production
# Sliding session TTL in seconds (default: 604800 = 7 days)
SESSION_TTL_SECONDS=604800
# Optional sliding-window rate limits per minute per IP
RATE_LIMIT_MAX_AUTH=25
RATE_LIMIT_MAX_API=240

# Database (PostgreSQL)
# Leave blank for zero-setup local Postgres (PGlite stored in ./data/kraya-pg).
# For live production, paste your Neon Serverless Postgres connection string:
DATABASE_URL=
PGLITE_DATA_DIR=./data/kraya-pg

# Persistent File Storage — Cloudflare R2 (10 GB free, ₹0 egress)
# On Cloudflare Workers, bind `VAULT_BUCKET` in apps/api/wrangler.toml (preferred).
# On Node.js / Docker, set the 4 S3-compatible R2 variables below:
# Leave blank in local dev to use the persistent local filesystem vault (./data/uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kraya-vault
# Optional custom S3-compatible endpoint override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
LOCAL_VAULT_DIR=./data/uploads

# AI Multimodal Extraction — Google Gemini API (aistudio.google.com)
# Note: Switch to Paid API key before onboarding commercial SMBs for zero-retention DPDP compliance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voice & Call Transcription + Multilingual WhatsApp Voice Notes
# Option 0 (Primary — ₹0 Local Own-Voice Cloning via github.com/debpalash/VoiceStudio):
# Run `pnpm voice:setup --audio ./my-voice.wav` to auto-clean your audio, clone your voice, and populate these keys:
VOICESTUDIO_BASE_URL=http://localhost:3900
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE_ID=
VOICESTUDIO_VOICE_MAP=
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_SEED=42
VOICESTUDIO_STT_ENABLED=false

# Option A (Cloud Fallback — Kannada, Tamil, Malayalam, Hindi, Hinglish & English):
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Option B (₹0 Free Fallback ASR): Groq Free Tier (console.groq.com)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Outbound Email — Resend Free Tier (3,000 emails/mo, 100/day)
# Used for team invitations, password reset links, and 1-click vendor email sends.
# Leave blank to use manual copy/mailto bridges locally.
RESEND_API_KEY=
RESEND_FROM_EMAIL=procurement@yourdomain.in

# Step 2 Live Channel Sync — Official Meta WhatsApp Business Cloud API
# Inbound vendor messages = FREE; first 1,000 service replies/mo = FREE
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=kraya-wa-verify-secret

# Step 2 Inbound Email / Call Webhooks (fail-closed)
INBOUND_WEBHOOK_SECRET=kraya-inbound-secret
# Explicit target workspace ID for webhooks if x-kraya-workspace-id header is not forwarded by your router:
WEBHOOK_DEFAULT_WORKSPACE_ID=

# Optional Live GSTIN Verification (offline Mod-36 checksum & PAN/state parsing always works at ₹0)
GSTIN_LOOKUP_API_URL=
GSTIN_LOOKUP_API_KEY=

# Optional Location & Google Maps Geocoding / Distance Matrix
# Leave blank to use OpenStreetMap Nominatim + OSRM Driving Distance (100% free, ₹0 zero-key fallback)
GOOGLE_MAPS_API_KEY=

# Optional Global Corporate Verification (GLEIF ISO 17442 G20 Registry is 100% free with ₹0 key)
# Optional OpenCorporates API key for additional secondary corporate checks
OPENCORPORATES_API_KEY=
