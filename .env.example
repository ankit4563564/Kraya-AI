# Kraya — Environment Configuration Template (Copy to .env)
# Local dev runs out-of-the-box with ZERO external keys (PGlite Postgres + local disk vault).

PORT=8787
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
REQUIRE_AUTH=true
SESSION_SECRET=replace-with-32-byte-random-hex
SESSION_TTL_SECONDS=604800
RATE_LIMIT_MAX_AUTH=25
RATE_LIMIT_MAX_API=240
DISTRIBUTED_RATE_LIMIT=false

# Database (leave empty for local PGlite; set Neon Postgres URL for production)
DATABASE_URL=
PGLITE_DATA_DIR=./data/kraya-pg

# File Vault (leave empty for local ./data/uploads; set R2 creds for production)
LOCAL_VAULT_DIR=./data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kraya-vault
R2_ENDPOINT=

# Multimodal AI & Google Search Grounding (Switch to Pay-As-You-Go before commercial SMBs!)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Voice Notes & Cloning (Local VoiceStudio, ElevenLabs Scribe/TTS, Groq Whisper fallback)
VOICESTUDIO_BASE_URL=http://localhost:3900
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE_ID=
VOICESTUDIO_VOICE_MAP=
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_SEED=42
VOICESTUDIO_STT_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Messaging & Inbound Webhooks
RESEND_API_KEY=
RESEND_FROM_EMAIL=procurement@yourdomain.in
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=kraya-wa-verify
INBOUND_WEBHOOK_SECRET=replace-with-strong-webhook-secret
WEBHOOK_DEFAULT_WORKSPACE_ID=
CRON_SECRET=replace-with-strong-cron-secret

# Live Indian Compliance & Directory Connectors
GSTN_API_PROVIDER=appyflow
GSTN_API_KEY=
GSTN_API_URL=
UDYAM_API_PROVIDER=surepass
UDYAM_API_KEY=
UDYAM_API_URL=
GOOGLE_MAPS_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
OPENCORPORATES_API_KEY=

# ERP Direct Push & Banking / Billing Connectors
ZOHO_BOOKS_ACCESS_TOKEN=
ZOHO_BOOKS_ORG_ID=
ZOHO_BOOKS_API_DOMAIN=https://www.zohoapis.in
TALLY_SERVER_URL=
TALLY_AUTH_HEADER=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# n8n Bi-Directional Event Bus & Live REST API Management
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_DEFAULT_WEBHOOK_URL=http://localhost:5678/webhook/kraya-events
N8N_WEBHOOK_SECRET=
