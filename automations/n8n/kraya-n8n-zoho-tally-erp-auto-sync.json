{
  "name": "Kraya — Zoho Books & Tally Prime Auto-Sync",
  "nodes": [
    {
      "id": "kraya-clean-inv",
      "name": "Kraya Clean Invoice Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "kraya-erp-sync",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "push-zoho",
      "name": "Create Bill in Zoho Books India",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.zohoapis.in/books/v3/bills?organization_id={{ $env.ZOHO_BOOKS_ORG_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Zoho-oauthtoken {{ $env.ZOHO_BOOKS_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ bill_number: $json.body.payload.invoiceNumber, date: $json.body.payload.invoiceDate, notes: \"Auto-audited by Kraya CFO Engine\" }) }}"
      }
    },
    {
      "id": "callback-kraya",
      "name": "Report ERP Sync Back to Kraya",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KRAYA_API_URL }}/api/connectors/n8n/callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-kraya-webhook-secret",
              "value": "={{ $env.INBOUND_WEBHOOK_SECRET }}"
            },
            {
              "name": "x-kraya-workspace-id",
              "value": "={{ $(\"Kraya Clean Invoice Event\").item.json.body.workspaceId }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: \"record_erp_sync\", invoiceId: $(\"Kraya Clean Invoice Event\").item.json.body.payload.invoiceId, erpProvider: \"zoho_books\", externalVoucherId: $json.bill?.bill_id || \"synced\" }) }}"
      }
    }
  ],
  "connections": {
    "Kraya Clean Invoice Event": {
      "main": [
        [
          {
            "node": "Create Bill in Zoho Books India",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Bill in Zoho Books India": {
      "main": [
        [
          {
            "node": "Report ERP Sync Back to Kraya",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}