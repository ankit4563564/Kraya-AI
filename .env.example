# =============================================================================
# KRAYA AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env before starting the server.
#
# ENVIRONMENT TIERS:
# 1. DEVELOPMENT: Runs 100% out-of-the-box with ZERO keys (PGlite WASM DB,
#    local disk file vault at ./data/uploads, deterministic regex intake).
# 2. STAGING: Pre-production pilot verification with isolated Neon Postgres,
#    secure sessions, and isolated test storage.
# 3. PRODUCTION: Hardened multi-tenant live environment with cloud PostgreSQL,
#    Cloudflare R2 storage, HTTPS-only origins, and mandatory secrets.
#
# RULE: Never commit your actual .env file or real credentials to git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# -----------------------------------------------------------------------------
# Target environment tier: development | staging | production
# [DEV: OPTIONAL (default: development) | STAGING: MANDATORY (staging) | PROD: MANDATORY (production)]
NODE_ENV=development

# Server listening port
# [DEV: OPTIONAL (default: 8787) | STAGING: MANDATORY | PROD: MANDATORY]
PORT=8787

# Allowed Web Client Origins (comma-separated for multiple origins, NO wildcards *)
# Staging example: https://staging.kraya.ai,http://localhost:5173
# Production MUST use https://: https://app.kraya.ai
# [DEV: OPTIONAL (default: http://localhost:5173) | STAGING: MANDATORY | PROD: MANDATORY]
APP_ORIGIN=http://localhost:5173

# Enforce authentication on all non-public API routes
# [DEV: OPTIONAL (default: true) | STAGING: MANDATORY (true) | PROD: MANDATORY (true)]
REQUIRE_AUTH=true

# -----------------------------------------------------------------------------
# 2. SECURITY, SESSIONS & RATE LIMITING
# -----------------------------------------------------------------------------
# Cryptographic session signing secret (minimum 32 characters, 64-char hex recommended)
# Generate with: openssl rand -hex 32
# [DEV: OPTIONAL (uses dev fallback) | STAGING: MANDATORY (>=32 chars) | PROD: MANDATORY (>=32 chars)]
SESSION_SECRET=replace_with_at_least_32_characters_random_hex_secret

# Session lifetime in seconds (default: 604800 = 7 days with sliding renewal)
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: OPTIONAL]
SESSION_TTL_SECONDS=604800

# Rate limits (sliding window 60s per IP)
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: OPTIONAL]
RATE_LIMIT_MAX_AUTH=25
RATE_LIMIT_MAX_API=240
DISTRIBUTED_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# 3. DATABASE — NEON POSTGRESQL (OR LOCAL PGLITE)
# -----------------------------------------------------------------------------
# Pooled PostgreSQL connection string (Neon pooled endpoint, port 6543 / -pooler suffix)
# Leave empty in local dev to automatically use PGlite WASM (zero installation needed).
# Staging & Production MUST provide an isolated Neon PostgreSQL URL.
# Example: postgres://kraya_app:YOUR_PASSWORD@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# [DEV: OPTIONAL | STAGING: MANDATORY | PROD: MANDATORY]
DATABASE_URL=

# Unpooled direct PostgreSQL connection string (Neon direct endpoint, port 5432)
# Required for running direct DDL migrations on Neon without PgBouncer transaction pooling.
# Example: postgres://kraya_app:YOUR_PASSWORD@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: OPTIONAL]
DATABASE_URL_UNPOOLED=

# Local PGlite database storage directory (used only when DATABASE_URL is empty)
PGLITE_DATA_DIR=./data/kraya-pg

# -----------------------------------------------------------------------------
# 4. FILE STORAGE — CLOUDFLARE R2 VAULT (OR LOCAL DISK VAULT)
# -----------------------------------------------------------------------------
# In local dev and staging, leave R2 credentials empty to use the local filesystem
# vault (./data/uploads). In production, set all 4 R2 variables for durable storage.
# [DEV: OPTIONAL | STAGING: OPTIONAL (falls back to local) | PROD: MANDATORY]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kraya-vault-staging
R2_ENDPOINT=

# Local vault storage directory (used when R2 credentials are unset)
LOCAL_VAULT_DIR=./data/uploads

# -----------------------------------------------------------------------------
# 5. MULTIMODAL AI — GOOGLE GEMINI (FLASH / FLASH-LITE)
# -----------------------------------------------------------------------------
# Google Gemini API key for structured procurement document extraction.
# If unset, Kraya falls back cleanly to deterministic local regex extraction.
# Note: Financial calculations are strictly performed by @kraya/finance-engine,
# never computed in prose by the LLM.
# [DEV: OPTIONAL | STAGING: RECOMMENDED | PROD: MANDATORY]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# -----------------------------------------------------------------------------
# 6. MESSAGING & WEBHOOK INTEGRATIONS
# -----------------------------------------------------------------------------
# Resend API for transactional procurement emails (purchase orders, RFQs)
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: RECOMMENDED]
RESEND_API_KEY=
RESEND_FROM_EMAIL=procurement@yourcompany.com

# Google Gmail API for direct vendor quotation & invoice inbox sync and threaded replies
# Google Cloud Console Authorized Redirect URI: http://localhost:8787/api/integrations/gmail/callback
# (Or in production: https://<your-api-domain>/api/integrations/gmail/callback)
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: OPTIONAL]
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_REDIRECT_URI=

# Meta WhatsApp Cloud API for supplier RFQ dispatch and vendor voice note ingest
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: OPTIONAL]
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=kraya-wa-verify-token

# Inbound external webhook HMAC secret (minimum 16 characters)
# [DEV: OPTIONAL | STAGING: RECOMMENDED | PROD: MANDATORY]
INBOUND_WEBHOOK_SECRET=replace_with_strong_webhook_hmac_secret_16chars

# Default workspace ID for unauthenticated inbound webhooks (must match a valid workspace UUID/ID)
WEBHOOK_DEFAULT_WORKSPACE_ID=

# Internal scheduled cron trigger secret (minimum 16 characters)
# [DEV: OPTIONAL | STAGING: RECOMMENDED | PROD: MANDATORY]
CRON_SECRET=replace_with_strong_cron_secret_16chars

# -----------------------------------------------------------------------------
# 7. INDIAN COMPLIANCE & DIRECTORY APIS
# -----------------------------------------------------------------------------
# Live GSTN verification provider (appyflow / surepass / offline)
# If unset, Kraya performs rigorous offline checksum and format verification.
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: RECOMMENDED]
GSTN_API_PROVIDER=appyflow
GSTN_API_KEY=
GSTN_API_URL=

# Udyam MSME verification provider (surepass / offline)
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: OPTIONAL]
UDYAM_API_PROVIDER=surepass
UDYAM_API_KEY=
UDYAM_API_URL=

# Real-time supplier search and grounding
# [DEV: OPTIONAL | STAGING: OPTIONAL | PROD: OPTIONAL]
SERPER_API_KEY=
TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=
OPENCORPORATES_API_KEY=

# -----------------------------------------------------------------------------
# 8. VOICE & AUDIO PROCESSING
# -----------------------------------------------------------------------------
# Local VoiceStudio service root (voice cloning & local STT)
VOICESTUDIO_BASE_URL=http://localhost:3900
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE_ID=
VOICESTUDIO_VOICE_MAP=
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_SEED=42
VOICESTUDIO_STT_ENABLED=false

# Cloud speech services fallback
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# -----------------------------------------------------------------------------
# 9. ERP & FINANCIAL CONNECTORS
# -----------------------------------------------------------------------------
# Zoho Books Integration
ZOHO_BOOKS_ACCESS_TOKEN=
ZOHO_BOOKS_ORG_ID=
ZOHO_BOOKS_API_DOMAIN=https://www.zohoapis.in

# Tally Server Integration
TALLY_SERVER_URL=
TALLY_AUTH_HEADER=

# Razorpay / RazorpayX Direct Payouts & Subscriptions
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 10. EXTERNAL AUTOMATION — n8n (MANAGED SEPARATELY)
# -----------------------------------------------------------------------------
# Note: n8n workflow hosting and activation are managed separately.
# These variables configure Kraya's bridge to post events to the external instance.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_DEFAULT_WEBHOOK_URL=http://localhost:5678/webhook/kraya-events
N8N_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 11. NEON SERVERLESS PLATFORM EXTENSIONS (OPTIONAL)
# -----------------------------------------------------------------------------
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
